<idea-plugin>
    <id>pl.adrros.bettercodereview</id>
    <name>BetterCodeReview</name>
    <vendor>adrros</vendor>
    <description><![CDATA[
        Better pull request reviews inside the IDE - small additions to the bundled GitHub Pull Requests UI:
        <ul>
            <li>Copy review comments (Cmd/Ctrl+C on a comment, or the context menu) - whole comment or the selected part.</li>
            <li>Emoji in review comments: <code>:smile:</code> completion and a searchable emoji picker.</li>
            <li>Paste screenshots and image files into review comments - uploaded as native GitHub attachments.</li>
            <li>A "Review…" button in the pull request details (and "Submit Review…" in the details, changes and timeline
                context menus): approve, request changes or comment, also after someone else already approved.
                Authors can only comment.</li>
            <li>The changed file open in the editor is tinted purple in the pull request's file tree, so you can see where
                you are and mark it as viewed; files with your not-yet-submitted review comments get an amber bar and a count;
                a file you viewed before new commits arrived gets a dash over its viewed-state slot. Clicking a ticked file
                cycles tick, dash ("read it again"), empty.</li>
            <li>In the Commit tool window a file you ticked that changed since (edited by you or written on disk by a tool)
                shows a dash in its checkbox, and clicking a ticked file first shows the dash, then unticks it; the file stays in
                the commit while dashed. Both click cycles can be switched off in the trees' context menus.</li>
            <li>Double-click or Enter on a file in the pull request's tree opens the file in the editor (the branch must be
                checked out); Alt+double-click opens the diff as before. Switchable in the tree's context menu.</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.github</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.BetterCodeReviewBundle</resource-bundle>

    <projectListeners>
        <listener class="pl.adrros.bettercodereview.review.files.CurrentReviewFile$EditorListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="BetterCodeReview" displayType="BALLOON"/>

        <postStartupActivity implementation="pl.adrros.bettercodereview.review.ReviewUiDecorationInstaller"/>

        <editorFactoryListener implementation="pl.adrros.bettercodereview.review.ReviewCommentEditorListener"/>

        <actionPromoter implementation="pl.adrros.bettercodereview.review.ReviewActionPromoter"/>

        <customPasteProvider implementation="pl.adrros.bettercodereview.paste.ReviewImagePasteProvider" order="first"/>

        <completion.contributor language="any"
                                implementationClass="pl.adrros.bettercodereview.emoji.EmojiCompletionContributor"/>

        <projectService serviceInterface="pl.adrros.bettercodereview.upload.AttachmentUploadService"
                        serviceImplementation="pl.adrros.bettercodereview.upload.GitHubAttachmentUploadService"/>

        <applicationService serviceInterface="pl.adrros.bettercodereview.review.ReviewTargets"
                            serviceImplementation="pl.adrros.bettercodereview.review.ReviewTargets$Default"/>
    </extensions>

    <actions>
        <action id="BetterCodeReview.CopyComment"
                class="pl.adrros.bettercodereview.copy.CopyCommentAction"
                use-shortcut-of="$Copy">
            <add-to-group group-id="EditMenu" anchor="last"/>
        </action>

        <action id="BetterCodeReview.CopyWholeComment"
                class="pl.adrros.bettercodereview.copy.CopyWholeCommentAction"/>

        <action id="BetterCodeReview.CopySelectedCommentText"
                class="pl.adrros.bettercodereview.copy.CopySelectedCommentTextAction"/>

        <group id="BetterCodeReview.CommentPopup">
            <reference ref="BetterCodeReview.CopyWholeComment"/>
            <reference ref="BetterCodeReview.CopySelectedCommentText"/>
        </group>

        <action id="BetterCodeReview.PasteImage"
                class="pl.adrros.bettercodereview.paste.PasteReviewImageAction">
            <add-to-group group-id="EditMenu" anchor="last"/>
        </action>

        <action id="BetterCodeReview.SubmitReview"
                class="pl.adrros.bettercodereview.review.submit.SubmitReviewAction"
                icon="AllIcons.Actions.Checked">
            <add-to-group group-id="Github.PullRequest.Details.Popup" anchor="first"/>
            <add-to-group group-id="Github.PullRequest.Changes.Popup" anchor="first"/>
            <add-to-group group-id="Github.PullRequest.Timeline.Popup" anchor="first"/>
        </action>

        <action id="BetterCodeReview.TreeOpensFile"
                class="pl.adrros.bettercodereview.review.files.TreeOpensFile$ToggleOpensFileAction">
            <add-to-group group-id="Github.PullRequest.Changes.Popup" anchor="last"/>
        </action>

        <action id="BetterCodeReview.ViewedCheckboxCycle"
                class="pl.adrros.bettercodereview.review.files.ViewedStateCycle$ToggleCycleAction">
            <add-to-group group-id="Github.PullRequest.Changes.Popup" anchor="last"/>
        </action>

        <action id="BetterCodeReview.CommitCheckboxMarks"
                class="pl.adrros.bettercodereview.commit.CommitInclusionMarks$ToggleMarksAction">
            <add-to-group group-id="ChangesViewPopupMenu" anchor="last"/>
        </action>

        <action id="BetterCodeReview.InsertEmoji"
                class="pl.adrros.bettercodereview.emoji.InsertEmojiAction">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift SEMICOLON"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="EditMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
