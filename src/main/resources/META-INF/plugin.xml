<idea-plugin>
    <id>pl.adrros.betterpullrequests</id>
    <name>BetterPullRequests</name>
    <vendor>adrros</vendor>
    <description><![CDATA[
        Better pull request reviews inside the IDE - small additions to the bundled GitHub Pull Requests UI:
        <ul>
            <li>Copy review comments (Cmd/Ctrl+C on a comment, or the context menu) - whole comment or the selected part.</li>
            <li>Emoji in review comments: <code>:smile:</code> completion and a searchable emoji picker.</li>
            <li>Paste screenshots and image files into review comments - uploaded as native GitHub attachments.</li>
            <li>A "Review…" button in the pull request details (and "Submit Review…" in the details, changes and timeline
                context menus): approve, request changes or comment, also after someone else already approved.
                Authors can only comment.</li>
            <li>The changed file you are reading is highlighted in the pull request's file tree, so ticking it as viewed is easy.</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.github</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.BetterPullRequestsBundle</resource-bundle>

    <projectListeners>
        <listener class="pl.adrros.betterpullrequests.review.files.CurrentReviewFile$EditorListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="BetterPullRequests" displayType="BALLOON"/>

        <postStartupActivity implementation="pl.adrros.betterpullrequests.review.ReviewUiDecorationInstaller"/>

        <editorFactoryListener implementation="pl.adrros.betterpullrequests.review.ReviewCommentEditorListener"/>

        <actionPromoter implementation="pl.adrros.betterpullrequests.review.ReviewActionPromoter"/>

        <customPasteProvider implementation="pl.adrros.betterpullrequests.paste.ReviewImagePasteProvider" order="first"/>

        <completion.contributor language="any"
                                implementationClass="pl.adrros.betterpullrequests.emoji.EmojiCompletionContributor"/>

        <projectService serviceInterface="pl.adrros.betterpullrequests.upload.AttachmentUploadService"
                        serviceImplementation="pl.adrros.betterpullrequests.upload.GitHubAttachmentUploadService"/>

        <applicationService serviceInterface="pl.adrros.betterpullrequests.review.ReviewTargets"
                            serviceImplementation="pl.adrros.betterpullrequests.review.ReviewTargets$Default"/>
    </extensions>

    <actions>
        <action id="BetterPullRequests.CopyComment"
                class="pl.adrros.betterpullrequests.copy.CopyCommentAction"
                use-shortcut-of="$Copy">
            <add-to-group group-id="EditMenu" anchor="last"/>
        </action>

        <action id="BetterPullRequests.CopyWholeComment"
                class="pl.adrros.betterpullrequests.copy.CopyWholeCommentAction"/>

        <action id="BetterPullRequests.CopySelectedCommentText"
                class="pl.adrros.betterpullrequests.copy.CopySelectedCommentTextAction"/>

        <group id="BetterPullRequests.CommentPopup">
            <reference ref="BetterPullRequests.CopyWholeComment"/>
            <reference ref="BetterPullRequests.CopySelectedCommentText"/>
        </group>

        <action id="BetterPullRequests.PasteImage"
                class="pl.adrros.betterpullrequests.paste.PasteReviewImageAction">
            <add-to-group group-id="EditMenu" anchor="last"/>
        </action>

        <action id="BetterPullRequests.SubmitReview"
                class="pl.adrros.betterpullrequests.review.submit.SubmitReviewAction"
                icon="AllIcons.Actions.Checked">
            <add-to-group group-id="Github.PullRequest.Details.Popup" anchor="first"/>
            <add-to-group group-id="Github.PullRequest.Changes.Popup" anchor="first"/>
            <add-to-group group-id="Github.PullRequest.Timeline.Popup" anchor="first"/>
        </action>

        <action id="BetterPullRequests.InsertEmoji"
                class="pl.adrros.betterpullrequests.emoji.InsertEmojiAction">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift SEMICOLON"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="EditMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
