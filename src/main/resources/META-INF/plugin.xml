<idea-plugin>
    <id>pl.adrros.gh-review-extras</id>
    <name>GitHub Review Extras</name>
    <vendor>adrros</vendor>
    <description><![CDATA[
        Small quality-of-life additions to the bundled GitHub Pull Requests review UI:
        <ul>
            <li>Copy review comments (Cmd/Ctrl+C on a comment, or the context menu) - whole comment or the selected part.</li>
            <li>Emoji in review comments: <code>:smile:</code> completion and a searchable emoji picker.</li>
            <li>Paste screenshots and image files into review comments - uploaded as native GitHub attachments.</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.github</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.GhReviewExtrasBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="GitHub Review Extras" displayType="BALLOON"/>

        <postStartupActivity implementation="pl.adrros.ghreviewextras.copy.CommentPanePopupInstaller"/>

        <actionPromoter implementation="pl.adrros.ghreviewextras.review.ReviewActionPromoter"/>

        <completion.contributor language="any"
                                implementationClass="pl.adrros.ghreviewextras.emoji.EmojiCompletionContributor"/>

        <projectService serviceInterface="pl.adrros.ghreviewextras.upload.AttachmentUploadService"
                        serviceImplementation="pl.adrros.ghreviewextras.upload.GitHubAttachmentUploadService"/>
    </extensions>

    <actions>
        <action id="GhReviewExtras.CopyComment"
                class="pl.adrros.ghreviewextras.copy.CopyCommentAction"
                use-shortcut-of="$Copy"/>

        <action id="GhReviewExtras.CopyWholeComment"
                class="pl.adrros.ghreviewextras.copy.CopyWholeCommentAction"/>

        <action id="GhReviewExtras.CopySelectedCommentText"
                class="pl.adrros.ghreviewextras.copy.CopySelectedCommentTextAction"/>

        <group id="GhReviewExtras.CommentPopup">
            <reference ref="GhReviewExtras.CopyWholeComment"/>
            <reference ref="GhReviewExtras.CopySelectedCommentText"/>
        </group>

        <action id="GhReviewExtras.PasteImage"
                class="pl.adrros.ghreviewextras.paste.PasteReviewImageAction"
                use-shortcut-of="$Paste"/>

        <action id="GhReviewExtras.InsertEmoji"
                class="pl.adrros.ghreviewextras.emoji.InsertEmojiAction">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt E"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
